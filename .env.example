# These are environment variables; export them before starting ASTFLOW.
ASTFLOW_MODEL=sentence-transformers/all-MiniLM-L6-v2
ASTFLOW_SEMANTIC=auto
ASTFLOW_CACHE=.astflow
ASTFLOW_TS_ENRICH=true
# auto uses a locally cached model; download explicitly with astflow model-download.
# ASTFLOW_SEMANTIC=off makes indexing fully lexical.
