# These are environment variables; export them before starting ASTFLOW. The defaults are the frozen submission
# configuration (validated full TEST NDCG@10 0.5509); you do not need to set anything.
ASTFLOW_MODEL=Alibaba-NLP/gte-modernbert-base
# on: the model is required; indexing stops with an actionable error if it is missing (npm run setup downloads it).
# off: explicit lexical-only (BM25) mode, reported as such in the UI, /api/health and the startup log.
ASTFLOW_SEMANTIC=on
# First-stage ranking: dense (frozen), hybrid (BM25 + dense RRF) or bm25.
ASTFLOW_RETRIEVAL=dense
ASTFLOW_CACHE=.astflow
# CPU threads for the embedding model (default up to 8, capped at physical cores).
# A positive integer override is accepted and still capped at physical cores.
ASTFLOW_THREADS=8
ASTFLOW_TS_ENRICH=true
