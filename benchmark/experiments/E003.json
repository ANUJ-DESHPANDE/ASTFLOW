{
  "id": "E003-dense-windows",
  "hypothesis": "23.5% of documents (2,061 / 8,765) exceed MiniLM's 256 word-piece limit, so their single dense vector ignores the rest of the code; embedding every part of a document lets Dense find answers it never retrieves, and Hybrid inherits them.",
  "change": "Dense document representation only: whole-document vector -> id-aligned sliding windows over word-pieces (window 256, overlap 64, stride 192), document score = max cosine over its windows. Existing Embedder.encode(use_windows=True) and Retriever max-pool path, used as-is.",
  "configurations": [
    {
      "window": 256,
      "overlap": 64,
      "pooling": "max"
    }
  ],
  "pre_registration": "benchmark/EXPERIMENTS.md (commit b8da241, before any E003 code)",
